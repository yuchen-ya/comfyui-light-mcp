{
  "name": "comfyui-light-mcp",
  "version": "0.3.0-rc.1",
  "description": "Lightweight ComfyUI MCP server: workflow-first, batch-native, context-light",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/index.js",
  "bin": {
    "comfyui-light-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "examples/*.json",
    "config.env.example",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke-real-comfyui.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^11.10.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
