# Copy to config.env; Node.js 22 reads this with --env-file.
# Relative directories resolve against the process working directory.
# Use absolute paths when configuring an MCP client.
COMFYUI_URL=http://127.0.0.1:8188
WORKFLOWS_DIR=./examples
DATA_DIR=./data
OUTPUT_DIR=./output
AUTO_SAVE_OUTPUTS=true
MAX_IN_FLIGHT=1
MAX_QUEUED_JOBS=1
JOB_TIMEOUT_MS=600000
